// ============================================================================
// PRISMA SCHEMA - HYBRID ERP SYSTEM (INVENTORY, SERVICES & STREAMING)
// Normalized in English + Unified with Better Auth
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (SCALABLE STATUSES & TYPES)
// ============================================================================

enum PurchaseStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  RECEIVED
  CANCELLED
}

enum SaleOutputType {
  SALE
  INTERNAL_CONSUMPTION
  SHRINKAGE
  OUTBOUND_ADJUSTMENT
}

enum SaleStatus {
  QUOTE
  PENDING_PAYMENT
  PARTIALLY_PAID
  COMPLETED
  VOIDED
}

enum SaleItemType {
  PRODUCT
  SERVICE
  SUBSCRIPTION
}

enum InventoryMovementType {
  PURCHASE_IN
  SALE_OUT
  SHRINKAGE_OUT
  TRANSFER_IN
  TRANSFER_OUT
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
}

enum PaymentFlowType {
  INFLOW  // Sale / subscription collection
  OUTFLOW // Purchase payment / supplier expense
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  REFUNDED
}

enum StreamingAccountStatus {
  AVAILABLE
  FULL
  EXPIRED
  DOWN_SUPPORT
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum FinancialAccountType {
  DOMESTIC_BANK
  INTERNATIONAL_BANK
  DIGITAL_WALLET // Zelle, Binance, PayPal, etc.
  CASH_REGISTER
}

// ============================================================================
// 1. AUTHENTICATION (BETTER AUTH), USERS, ROLES & PERMISSIONS (RBAC)
// ============================================================================

model User {
  id            String    @id @default(uuid())
  name          String
  lastName      String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  username      String?   @unique
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Better Auth Core Relations
  sessions Session[]
  accounts Account[]

  // Security Relations (RBAC & Direct Overrides)
  roles             UserRole[]
  directPermissions UserPermission[]

  // Operational Audit Relations
  purchases           Purchase[]
  sales               Sale[]
  inventoryMovements  InventoryMovement[]
  paymentTransactions PaymentTransaction[]

  @@index([email])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // Better Auth stores credential password hashes here
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., ADMIN, SELLER, WAREHOUSE, SUPPORT
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations (Join Tables)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "purchases.create", "inventory.edit", "streaming.view_credentials"
  name        String
  module      String   // e.g., "PURCHASES", "SALES", "INVENTORY", "STREAMING", "FINANCE"
  description String?
  createdAt   DateTime @default(now())

  // Relations (Join Tables)
  roles RolePermission[]
  users UserPermission[]

  @@index([module])
  @@map("permissions")
}

/// N:M Join Table between Users and Roles
model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// N:M Join Table between Roles and Permissions
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// N:M Join Table between Users and Permissions for direct exceptions/overrides
model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  isGranted    Boolean  @default(true) // true = grants extra permission, false = revokes role-inherited permission
  assignedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ============================================================================
// 2. FINANCIAL MODULE: CURRENCIES, EXCHANGE RATES, ACCOUNTS & PAYMENT METHODS
// ============================================================================

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique // e.g., USD, VES, EUR, COP, USDT
  name      String
  symbol    String   // e.g., $, Bs., €
  isBase    Boolean  @default(false) // System base accounting currency
  decimals  Int      @default(2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Exchange rate requires Source Currency and Target Currency
  sourceExchangeRates ExchangeRate[] @relation("SourceCurrency")
  targetExchangeRates ExchangeRate[] @relation("TargetCurrency")

  financialAccounts   FinancialAccount[]
  purchases           Purchase[]
  sales               Sale[]
  paymentTransactions PaymentTransaction[]

  @@map("currencies")
}

model ExchangeRate {
  id               String    @id @default(uuid())
  sourceCurrencyId String
  targetCurrencyId String
  rate             Decimal   @db.Decimal(18, 6)
  source           String?   // e.g., "BCV", "Parallel", "Binance P2P", "Manual"
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime? // Null if currently active rate
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  sourceCurrency Currency @relation("SourceCurrency", fields: [sourceCurrencyId], references: [id])
  targetCurrency Currency @relation("TargetCurrency", fields: [targetCurrencyId], references: [id])

  purchases           Purchase[]
  sales               Sale[]
  paymentTransactions PaymentTransaction[]

  @@index([sourceCurrencyId, targetCurrencyId, isActive])
  @@index([effectiveFrom])
  @@map("exchange_rates")
}

model PaymentMethod {
  id                String   @id @default(uuid())
  name              String   @unique // e.g., Pago Movil, Zelle, Wire Transfer, Cash, Binance Pay
  requiresReference Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  financialAccounts   FinancialAccountPaymentMethod[]
  paymentTransactions PaymentTransaction[]

  @@map("payment_methods")
}

model FinancialAccount {
  id             String               @id @default(uuid())
  name           String               // e.g., "Banesco Main", "Petty Cash USD", "Corporate Zelle"
  type           FinancialAccountType @default(DOMESTIC_BANK)
  bankName       String?
  accountNumber  String?
  holderName     String?
  identifier     String?              // Associated Tax ID / National ID / Email / Phone
  currencyId     String
  currentBalance Decimal              @default(0) @db.Decimal(18, 2)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  currency            Currency                        @relation(fields: [currencyId], references: [id])
  paymentMethods      FinancialAccountPaymentMethod[]
  paymentTransactions PaymentTransaction[]

  @@index([currencyId])
  @@map("financial_accounts")
}

/// N:M Join Table between Financial Accounts and Payment Methods
model FinancialAccountPaymentMethod {
  id                 String   @id @default(uuid())
  financialAccountId String
  paymentMethodId    String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  paymentMethod    PaymentMethod    @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([financialAccountId, paymentMethodId])
  @@map("financial_account_payment_methods")
}

/// Transactional entity supporting split payments, partial payments, and multi-currency
/// across both Purchases (Outflows) and Sales (Inflows)
model PaymentTransaction {
  id                 String          @id @default(uuid())
  flowType           PaymentFlowType // INFLOW (Sale) or OUTFLOW (Purchase)
  status             PaymentStatus   @default(VERIFIED)
  purchaseId         String?
  saleId             String?
  financialAccountId String
  paymentMethodId    String
  currencyId         String
  exchangeRateId     String?
  userId             String?
  amount             Decimal         @db.Decimal(18, 2) // Amount in payment currency
  baseCurrencyAmount Decimal         @db.Decimal(18, 2) // Equivalent in system base currency
  reference          String?         // Bank reference / receipt number
  receiptUrl         String?
  notes              String?
  paidAt             DateTime        @default(now())
  createdAt          DateTime        @default(now())

  purchase         Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  sale             Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  paymentMethod    PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  currency         Currency         @relation(fields: [currencyId], references: [id])
  exchangeRate     ExchangeRate?    @relation(fields: [exchangeRateId], references: [id])
  user             User?            @relation(fields: [userId], references: [id])

  @@index([purchaseId])
  @@index([saleId])
  @@index([financialAccountId])
  @@index([paidAt])
  @@map("payment_transactions")
}

// ============================================================================
// 3. PRODUCT CATALOG & SUPPLIERS MODULE
// ============================================================================

model MeasurementUnit {
  id             String   @id @default(uuid())
  name           String   @unique // e.g., Unit, Kilogram, Liter, Box, Meter
  abbreviation   String   @unique // e.g., UNT, KG, LT, BOX, MT
  allowsDecimals Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  products Product[]

  @@map("measurement_units")
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  description      String?
  parentCategoryId String?  // Supports hierarchical subcategories
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentCategory Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories  Category[] @relation("CategoryHierarchy")
  products       Product[]

  @@index([parentCategoryId])
  @@map("categories")
}

model Product {
  id                String    @id @default(uuid())
  sku               String    @unique
  barcode           String?   @unique
  name              String
  description       String?
  measurementUnitId String
  brandId           String?
  categoryId        String
  averageCost       Decimal   @default(0) @db.Decimal(18, 4)
  baseSalePrice     Decimal   @db.Decimal(18, 2)
  wholesalePrice    Decimal?  @db.Decimal(18, 2)
  minStockAlert     Decimal   @default(0) @db.Decimal(18, 3)
  imageUrl          String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  measurementUnit MeasurementUnit @relation(fields: [measurementUnitId], references: [id])
  brand           Brand?          @relation(fields: [brandId], references: [id])
  category        Category        @relation(fields: [categoryId], references: [id])

  suppliers          SupplierProduct[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model Supplier {
  id          String    @id @default(uuid())
  legalName   String
  tradeName   String?
  taxId       String?   @unique // RIF, NIT, RUC, Tax ID
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products          SupplierProduct[]
  purchases         Purchase[]
  streamingAccounts StreamingAccount[]

  @@map("suppliers")
}

/// N:M Join Table between Suppliers and Products
model SupplierProduct {
  id                String   @id @default(uuid())
  supplierId        String
  productId         String
  supplierSku       String?  // Supplier's own catalog code for this product
  lastCost          Decimal? @db.Decimal(18, 4)
  isPrimarySupplier Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
  @@map("supplier_products")
}

// ============================================================================
// 4. PURCHASES & MULTI-WAREHOUSE INVENTORY MODULE
// ============================================================================

model Location {
  id               String   @id @default(uuid())
  code             String   @unique // e.g., "WH-MAIN", "STORE-01", "SHELF-A1"
  name             String
  description      String?
  address          String?
  parentLocationId String?  // Allows hierarchy: Branch -> Warehouse -> Aisle -> Shelf
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentLocation Location?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  sublocations   Location[] @relation("LocationHierarchy")

  inventories   Inventory[]
  purchaseItems PurchaseItem[]

  @@map("locations")
}

/// Represents current stock of a Product at a specific Location
model Inventory {
  id               String   @id @default(uuid())
  productId        String
  locationId       String
  currentQuantity  Decimal  @default(0) @db.Decimal(18, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(18, 3) // Stock committed to pending sales
  specificLocation String?  // e.g., "Level 2, Bin 4"
  updatedAt        DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  movements InventoryMovement[]
  saleItems SaleItem[]

  @@unique([productId, locationId])
  @@index([locationId])
  @@map("inventories")
}

/// Kardex / Audit entity tracking every inbound and outbound Inventory movement
model InventoryMovement {
  id             String                @id @default(uuid())
  inventoryId    String
  productId      String
  movementType   InventoryMovementType
  quantity       Decimal               @db.Decimal(18, 3)
  previousStock  Decimal               @db.Decimal(18, 3)
  resultingStock Decimal               @db.Decimal(18, 3)
  unitCost       Decimal?              @db.Decimal(18, 4)
  purchaseItemId String?
  saleItemId     String?
  userId         String?
  reason         String?
  movedAt        DateTime              @default(now())

  inventory    Inventory     @relation(fields: [inventoryId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  saleItem     SaleItem?     @relation(fields: [saleItemId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([inventoryId, movedAt])
  @@index([productId])
  @@map("inventory_movements")
}

model Purchase {
  id                    String         @id @default(uuid())
  orderNumber           String         @unique
  supplierInvoiceNumber String?        // Supplier invoice or delivery note number
  supplierId            String
  userId                String?
  currencyId            String
  exchangeRateId        String?
  exchangeRateValue     Decimal        @default(1) @db.Decimal(18, 6) // Historical rate snapshot at purchase time
  status                PurchaseStatus @default(PENDING)
  subtotal              Decimal        @db.Decimal(18, 2)
  taxAmount             Decimal        @default(0) @db.Decimal(18, 2)
  discountAmount        Decimal        @default(0) @db.Decimal(18, 2)
  total                 Decimal        @db.Decimal(18, 2)
  totalPaid             Decimal        @default(0) @db.Decimal(18, 2)
  purchasedAt           DateTime       @default(now())
  dueDate               DateTime?      // For credit purchases
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id])

  items             PurchaseItem[]
  payments          PaymentTransaction[]
  streamingAccounts StreamingAccount[] // When purchasing batches of streaming accounts

  @@index([supplierId])
  @@index([purchasedAt])
  @@index([status])
  @@map("purchases")
}

/// Purchase line items connecting Purchase with Products, Services, and destination Location
model PurchaseItem {
  id                    String  @id @default(uuid())
  purchaseId            String
  productId             String? // Optional if buying a service/license batch
  serviceId             String? // Optional if buying balance/accounts for a service
  destinationLocationId String? // Which warehouse/location receives this line item
  description           String?
  quantity              Decimal @db.Decimal(18, 3)
  receivedQuantity      Decimal @default(0) @db.Decimal(18, 3)
  unitCost              Decimal @db.Decimal(18, 4)
  taxPercentage         Decimal @default(0) @db.Decimal(5, 2)
  discountAmount        Decimal @default(0) @db.Decimal(18, 2)
  subtotal              Decimal @db.Decimal(18, 2)

  purchase            Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product?  @relation(fields: [productId], references: [id])
  service             Service?  @relation(fields: [serviceId], references: [id])
  destinationLocation Location? @relation(fields: [destinationLocationId], references: [id])

  inventoryMovements InventoryMovement[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// ============================================================================
// 5. SERVICES, STREAMING ACCOUNTS & SUBSCRIPTIONS MODULE
// ============================================================================

model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "Video Streaming", "Music Streaming", "Software License", "Technical Support"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@map("service_types")
}

model Service {
  id                        String   @id @default(uuid())
  code                      String   @unique
  name                      String   // e.g., "Netflix Single Screen", "Netflix Full Account", "Spotify Duo"
  description               String?
  serviceTypeId             String
  basePrice                 Decimal  @db.Decimal(18, 2)
  defaultDurationDays       Int?     @default(30) // For recurring services / subscriptions
  requiresStreamingAccount  Boolean  @default(false)
  isFullAccountSale         Boolean  @default(false)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  streamingAccounts StreamingAccount[]
  subscriptions     Subscription[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]

  @@index([serviceTypeId])
  @@map("services")
}

model StreamingAccount {
  id                 String                 @id @default(uuid())
  serviceId          String
  supplierId         String?
  purchaseId         String?                // Purchase batch where the account was acquired
  accessEmail        String
  accessPassword     String                 // Recommended: encrypt at application layer
  securityPin        String?
  profileCapacity    Int                    @default(1) // e.g., 5 screens for Netflix, 1 for full account
  occupiedProfiles   Int                    @default(0)
  accountCost        Decimal?               @db.Decimal(18, 2)
  supplierStartDate  DateTime               @default(now())
  supplierCutoffDate DateTime               // Master account expiration date with supplier
  status             StreamingAccountStatus @default(AVAILABLE)
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  service  Service   @relation(fields: [serviceId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  profiles      StreamingProfile[]
  subscriptions Subscription[]

  @@index([serviceId, status])
  @@index([supplierCutoffDate])
  @@map("streaming_accounts")
}

/// Splits a StreamingAccount into individual screens/profiles
model StreamingProfile {
  id                 String   @id @default(uuid())
  streamingAccountId String
  slotNumber         Int      // e.g., Profile 1, Profile 2, Profile 3...
  profileName        String?  // Name assigned inside the streaming app
  profilePin         String?  // 4-digit profile PIN
  isOccupied         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  streamingAccount StreamingAccount @relation(fields: [streamingAccountId], references: [id], onDelete: Cascade)
  subscriptions    Subscription[]

  @@unique([streamingAccountId, slotNumber])
  @@map("streaming_profiles")
}

model Customer {
  id         String    @id @default(uuid())
  name       String
  lastName   String?
  documentId String?   @unique // National ID / Tax ID / Passport
  phone      String?   // Key for WhatsApp reminder notifications
  email      String?
  address    String?
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  sales         Sale[]
  subscriptions Subscription[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

model Subscription {
  id                 String             @id @default(uuid())
  code               String             @unique
  customerId         String
  serviceId          String
  streamingAccountId String?            // Assigned master streaming account
  streamingProfileId String?            // Assigned specific screen/profile (if not full account)
  agreedPrice        Decimal            @db.Decimal(18, 2)
  startDate          DateTime           @default(now())
  expirationDate     DateTime           // Customer cutoff/renewal date
  autoRenew          Boolean            @default(true)
  status             SubscriptionStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id])
  service          Service           @relation(fields: [serviceId], references: [id])
  streamingAccount StreamingAccount? @relation(fields: [streamingAccountId], references: [id])
  streamingProfile StreamingProfile? @relation(fields: [streamingProfileId], references: [id])

  // History of all sales (initial signup and monthly renewals) for this subscription
  saleItems SaleItem[]

  @@index([customerId])
  @@index([status, expirationDate])
  @@index([streamingAccountId])
  @@map("subscriptions")
}

// ============================================================================
// 6. SALES / OUTBOUND & HYBRID BILLING MODULE
// ============================================================================

model Sale {
  id                String         @id @default(uuid())
  documentNumber    String         @unique // Sequential invoice / outbound note number
  outputType        SaleOutputType @default(SALE)
  status            SaleStatus     @default(COMPLETED)
  customerId        String?        // Optional for internal consumption or walk-in counter sales
  userId            String?        // Seller or staff member who recorded the sale
  currencyId        String
  exchangeRateId    String?
  exchangeRateValue Decimal        @default(1) @db.Decimal(18, 6) // Historical rate snapshot at sale time
  subtotal          Decimal        @db.Decimal(18, 2)
  taxAmount         Decimal        @default(0) @db.Decimal(18, 2)
  discountAmount    Decimal        @default(0) @db.Decimal(18, 2)
  total             Decimal        @db.Decimal(18, 2)
  totalCollected    Decimal        @default(0) @db.Decimal(18, 2)
  soldAt            DateTime       @default(now())
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  customer     Customer?     @relation(fields: [customerId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  currency     Currency      @relation(fields: [currencyId], references: [id])
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id])

  items    SaleItem[]
  payments PaymentTransaction[]

  @@index([customerId])
  @@index([soldAt])
  @@index([status])
  @@map("sales")
}

/// Polymorphic line-item table allowing a single Sale to bill:
/// 1) Physical Products from Inventory, 2) One-off Services, and 3) Subscription Signups/Renewals
model SaleItem {
  id                 String       @id @default(uuid())
  saleId             String
  itemType           SaleItemType
  inventoryId        String?      // If PRODUCT: which inventory location/lot it is drawn from
  productId          String?      // If PRODUCT: direct product reference
  serviceId          String?      // If SERVICE or SUBSCRIPTION
  subscriptionId     String?      // If billing a Subscription signup or renewal
  description        String       // Description printed on receipt
  quantity           Decimal      @default(1) @db.Decimal(18, 3)
  unitPrice          Decimal      @db.Decimal(18, 2)
  historicalUnitCost Decimal?     @db.Decimal(18, 4) // For calculating real profit margin
  discountAmount     Decimal      @default(0) @db.Decimal(18, 2)
  taxPercentage      Decimal      @default(0) @db.Decimal(5, 2)
  subtotal           Decimal      @db.Decimal(18, 2)

  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  inventory    Inventory?    @relation(fields: [inventoryId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  inventoryMovements InventoryMovement[]

  @@index([saleId])
  @@index([productId])
  @@index([serviceId])
  @@index([subscriptionId])
  @@map("sale_items")
}